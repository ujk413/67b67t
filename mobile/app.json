{
  "expo": {
    "name": "67chat",
    "slug": "messenger67-mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-1024.png",
    "userInterfaceStyle": "automatic",
    "plugins": [],
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна для фото, видеокружков и звонков",
        "NSMicrophoneUsageDescription": "Микрофон нужен для голосовых сообщений и звонков",
        "NSPhotoLibraryUsageDescription": "Доступ к галерее нужен для отправки фото и видео"
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "ru.b67t.messenger.mobile",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#14B88F",
        "foregroundImage": "./assets/brand/app-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
