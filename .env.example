POSTGRES_USER=messenger
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
POSTGRES_DB=messenger
DATABASE_URL=postgres://messenger:GENERATE_SECURE_PASSWORD_HERE@postgres:5432/messenger
# Allowed CORS origin(s). Single origin, or a comma-separated list (no spaces needed),
# e.g. to also allow the Tor hidden service (see scripts/show_onion.sh):
# ORIGIN=https://67chat.ru,http://yourhiddenservice.onion
ORIGIN=https://67chat.ru

# Encryption key for metadata (display_name, room titles, etc.)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Firebase Cloud Messaging (for mobile push notifications)
# Get from Firebase Console → Project Settings → Cloud Messaging → Server Key
FCM_SERVER_KEY=

USE_S3=false
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1
SWIFT_ENDPOINT=https://swift.twcstorage.ru
SWIFT_ACCESS_KEY=
SWIFT_SECRET_KEY=
HCAPTCHA_SECRET=
# Comma-separated admin usernames. Users can also be promoted in the DB: UPDATE users SET is_admin=true WHERE username='...'
ADMIN_USERNAMES=
SYSTEM_ADMIN_USERNAME=
SYSTEM_ADMIN_PASSWORD=
SYSTEM_CHANNEL_TITLE=
# TURN (coturn, time-limited credentials). TURN_SECRET is the shared secret between
# the API and coturn (use-auth-secret); clients receive short-lived HMAC credentials
# from GET /rtc/ice-servers. Generate with: openssl rand -hex 32
TURN_SECRET=GENERATE_SECURE_PASSWORD_HERE
TURN_REALM=67chat.ru
TURN_EXTERNAL_IP=YOUR_SERVER_PUBLIC_IP
TURN_RELAY_IP=172.18.0.2
# Optional: explicit comma-separated TURN URLs handed to clients
# (default: turn:$TURN_EXTERNAL_IP:3478 over udp and tcp)
TURN_URLS=
# Credential lifetime in seconds (default 3600)
TURN_CREDENTIAL_TTL_SEC=3600
# Removed: TURN_STATIC_USER / TURN_STATIC_PASSWORD (static shared password).

# Localhost mode (use with docker-compose.local.yml)
LOCAL_ORIGIN=http://localhost
LOCAL_DATABASE_URL=postgres://messenger:GENERATE_SECURE_PASSWORD_HERE@postgres:5432/messenger
LOCAL_TURN_REALM=localhost
LOCAL_TURN_USER=messenger
LOCAL_TURN_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
